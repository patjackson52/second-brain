[Unit]
Description=Second Brain Weekly Summary Automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/workspace/second-brain
ExecStart=/srv/scripts/weekly-summary.sh
Environment=VAULT_DIR=/srv/workspace/second-brain
Environment=CLAUDE_LOCK_FILE=/srv/locks/claude-exec.lock
